# Copy to .env.local. All optional.

# Folder with projects.json and ideas.json (default: data/sources)
STORY_LAB_SOURCES=
# Folder of agent-run receipts: <dir>/<loop>/<run>.md with STATUS:/DID: lines (default: none)
STORY_LAB_RECEIPTS=
# Where saved treatments are written (default: data/drafts)
STORY_LAB_DRAFTS=
# If set, every API request needs this value as an x-story-lab-key header or story_lab_key cookie
STORY_LAB_KEY=
# AI director: Claude Code CLI binary and model alias (defaults: claude, opus)
STORY_LAB_CLAUDE_BIN=
STORY_LAB_MODEL=
